# Copy to .env and fill in the required values.
# Docker Compose reads .env automatically. For Spring Boot, load these
# variables into the process environment or configure your IDE to load .env.

# MySQL (Docker Compose)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=haruharu

# Gemini: choose a model available to your API key.
GEMINI_API_KEY=
GEMINI_MODEL=

# JWT: Base64-encoded random secret of at least 32 bytes.
JWT_SECRET=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
# Optional public URL prefix; leave empty to use the application's default.
AWS_S3_PUBLIC_BASE_URL=
# Optional when using an AWS profile or IAM role through the default provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
