# Copy to .env and fill in the OAuth values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Must match GOOGLE_CLIENT_ID in the backend environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/login/google/callback

# Must match KAKAO_REST_API_KEY in the backend environment.
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/login/kakao/callback
